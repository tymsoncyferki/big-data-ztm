# Copy to .env and set a different value for each secret.
NIFI_USERNAME=admin
NIFI_PASSWORD=REPLACE_WITH_A_UNIQUE_LONG_PASSWORD
NIFI_SENSITIVE_PROPS_KEY=REPLACE_WITH_ANOTHER_UNIQUE_LONG_KEY

# Required ONLY for --with-data (GPS + Warsaw environmental API).
WEATHER_API_TOKEN=REPLACE_WITH_YOUR_WARSAW_API_TOKEN

# Required for bootstrap (Hive always starts): Hive Metastore PostgreSQL password.
HIVE_DB_PASSWORD=REPLACE_WITH_LOCAL_HIVE_PASSWORD

# Optional Spark tuning (tested workaround for Spark local scheduler stalls).
SPARK_LOCALITY_WAIT=0s
SPARK_SCHEDULER_DEBUG=0
